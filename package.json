{
  "name": "scripture-trails",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "description": "A Bible reader with ESV, NASB20, NIV and NKJV translations and visual Scripture discovery",
  "scripts": {
    "dev": "wrangler pages dev public",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report",
    "import:refs": "node scripts/import-crossrefs.mjs",
    "deploy": "wrangler pages deploy public --project-name scripture-trails",
    "build": "npm run check:release && npm run check:refs && npm run check:stats && npm run check:v1 && npm run test",
    "check:refs": "node scripts/check-crossrefs.mjs",
    "release": "node scripts/release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:stats": "node scripts/site-stats.mjs --check",
    "check:v1": "node scripts/check-v1-readiness.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
